# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS, separados por coma (frontend Angular por defecto en :4200)
CORS_ORIGINS=http://localhost:4200

# Prefijo de la API
API_PREFIX=/api/v1

# MongoDB (Atlas): pegar la cadena de conexión completa, incluyendo el nombre de la base
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/turipat?retryWrites=true&w=majority
# JWT_SECRET=cambiar-por-un-secreto-largo
# JWT_EXPIRES_IN=1h

# MongoDB (Atlas): incluir SIEMPRE el nombre de la base antes de "?"
# Si falta, Mongoose usa la base "test" sin avisar (la app lo bloquea al arrancar).
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/turipat?retryWrites=true&w=majority
