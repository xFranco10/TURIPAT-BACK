# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS, separados por coma (frontend Angular por defecto en :4200)
CORS_ORIGINS=http://localhost:4200

# Prefijo de la API
API_PREFIX=/api/v1

# Se usarán cuando se integre MongoDB / autenticación (aún no se leen)
# MONGODB_URI=mongodb://localhost:27017/turipat
# JWT_SECRET=cambiar-por-un-secreto-largo
# JWT_EXPIRES_IN=1h
